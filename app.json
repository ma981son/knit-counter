{
  "expo": {
    "name": "knit-counter",
    "slug": "knit-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/colored-background.png",
    "scheme": "knitcounter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#211A1E",
        "foregroundImage": "./assets/images/transparent-light.png",
        "monochromeImage": "./assets/images/monochrome-dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ma981son.knitcounter"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/colored-background.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent-dark.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F4EBE6",
          "dark": {
            "image": "./assets/images/transparent-light.png",
            "backgroundColor": "#211A1E"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf3df953-6bb4-4d14-b630-19a27fdfb55f"
      }
    }
  }
}
