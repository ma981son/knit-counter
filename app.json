{
  "expo": {
    "name": "knit-counter",
    "slug": "knit-counter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/rosadito-background-dark.png",
    "scheme": "knitcounter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#211A1E",
        "foregroundImage": "./assets/images/rosadito-transparent-dark.png",
        "monochromeImage": "./assets/images/monochrome-dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ma981son.knitcounter"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/rosadito-background-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/rosadito-transparent-light.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#F4EBE6",
          "dark": {
            "image": "./assets/images/rosadito-transparent-dark.png",
            "backgroundColor": "#211A1E"
          }
        }
      ],
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "es", "de"]
        }
      ],
      "./plugins/withLocalProperties.js",
      "./plugins/withAppIconAliases.js",
      [
        "./plugins/withPaletteSplash.js",
        {
          "imageWidth": 288,
          "themes": [
            {
              "name": "Jarrito",
              "image": "./assets/images/jarrito-transparent-light.png",
              "backgroundColor": "#F4EBDC",
              "dark": {
                "image": "./assets/images/jarrito-transparent-dark.png",
                "backgroundColor": "#1E1813"
              }
            }
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Jarrito",
            "ios": "./assets/images/jarrito-background-dark.png",
            "android": {
              "foregroundImage": "./assets/images/jarrito-transparent-dark.png",
              "backgroundColor": "#1E1813",
              "monochromeImage": "./assets/images/monochrome-dark.png"
            }
          },
          {
            "name": "JarritoLight",
            "ios": "./assets/images/jarrito-background-light.png",
            "android": {
              "foregroundImage": "./assets/images/jarrito-transparent-light.png",
              "backgroundColor": "#F4EBDC",
              "monochromeImage": "./assets/images/monochrome-dark.png"
            }
          },
          {
            "name": "RosaditoLight",
            "ios": "./assets/images/rosadito-background-light.png",
            "android": {
              "foregroundImage": "./assets/images/rosadito-transparent-light.png",
              "backgroundColor": "#F4EBE6",
              "monochromeImage": "./assets/images/monochrome-dark.png"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf3df953-6bb4-4d14-b630-19a27fdfb55f"
      }
    }
  }
}
